// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. تحديد أنواع الصلاحيات في النظام
enum Role {
  ADMIN
  DOCTOR
}

// 2. جدول المستخدمين
model User {
  id          String    @id @default(cuid())
  username    String    @unique
  password    String    // يتم حفظها مشفرة 
  name        String    // اسم الدكتور أو المدير
  role        Role      @default(DOCTOR)
  totpSecret  String?   // حفظ كود المصادقة الثنائية 2FA
  createdAt   DateTime  @default(now())
  
  // علاقة: الدكتور يمكن أن يكون لديه عدة مرضى
  patients    Patient[] 
}

// 3. جدول المرضى
model Patient {
  id              String   @id @default(cuid())
  patientId       String   @unique 
  fullName        String?
  gender          Int 
  educationYears  Int?
  createdAt       DateTime @default(now())
  
  // ربط المريض بالدكتور المسؤول عنه
  doctorId        String?
  doctor          User?    @relation(fields: [doctorId], references: [id])
  
  visits          Visit[]
}

// 4. جدول الزيارات
model Visit {
  id              String   @id @default(cuid())
  patient         Patient  @relation(fields: [patientId], references: [patientId])
  patientId       String
  
  visitDate       DateTime @default(now())
  ageAtVisit      Float
  
  // المؤشرات الحيويه (المدخلات الحالية من الدكتور)
  mmse            Float    // نتيجة الـ MMSE الحالية
  aqp7            Float?
  rps5            Float?
  chd2            Float?
  snx5            Float?
  ass1            Float?
  unchar          Float?
  
  // نتائج الذكاء الاصطناعي (المخرجات)
  futureMmse      Float?   // الحقل الجديد: التوقع الرقمي المستقبلي للـ MMSE
  prediction      String?  // مستوى الخطر النصي (مثلاً: High, Low)
  confidence      Float?   // نسبة ثقة النموذج في التوقع
  maeAtVisit      Float    @default(0.3907) // هامش الخطأ

  @@index([patientId, visitDate]) 
}

model PlatformTraffic {
  id        String   @id @default(cuid())
  path      String   // الصفحة التي تم زيارتها فالبداية ما راح نحفظ الا الصفحه الاساسيه
  createdAt DateTime @default(now())
}