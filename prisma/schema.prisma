generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Patient {
  id              String   @id @default(cuid())
  patientId       String   @unique 
  fullName        String?
  gender          Int 
  educationYears  Int?
  createdAt       DateTime @default(now())
  
  visits          Visit[]
}

model Visit {
  id              String   @id @default(cuid())
  patient         Patient  @relation(fields: [patientId], references: [patientId])
  patientId       String
  
  visitDate       DateTime @default(now())
  ageAtVisit      Float
  
  mmse            Float
  cdrsb           Float
  hippocampusVol  Float?  
  abeta           Float?
  tau             Float?
  
  prediction      String?  
  confidence      Float?   
  maeAtVisit      Float    @default(0.3907) 

  @@index([patientId, visitDate]) 
}

